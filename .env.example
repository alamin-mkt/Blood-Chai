# BloodBondhu / রক্ত চাই — Environment Configuration

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Details
NEXT_PUBLIC_APP_NAME="রক্ত চাই (BloodBondhu)"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Provider (Resend / SendGrid / Supabase Auth)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=noreply@roktochai.gov.bd

# SMS Provider for Bangladesh (e.g. SSL Wireless / Greenweb / Teletalk)
SMS_PROVIDER=ssl_wireless
SMS_API_KEY=
SMS_SENDER_ID=ROKTOCHAI

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Map
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
